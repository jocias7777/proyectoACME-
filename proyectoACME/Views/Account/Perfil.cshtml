@using proyectoACME.Models.Entities
@model Usuario
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mi Perfil";
}

<h1 class="page-title">Mi Perfil</h1>
<p class="page-sub">Informaci&oacute;n de tu cuenta</p>

<div style="max-width:520px;">
    <div class="card-acme">

        <!-- Avatar -->
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;
                    padding-bottom:20px;border-bottom:1px solid #E5E4E0;">
            <div style="width:56px;height:56px;background:#2383E2;border-radius:50%;
                        display:flex;align-items:center;justify-content:center;
                        font-size:22px;font-weight:500;color:#fff;">
                @Model.Username.Substring(0, 1).ToUpper()
            </div>
            <div>
                <div style="font-size:16px;font-weight:500;color:#1A1A1A;">@Model.Username</div>
                <div style="font-size:12px;color:#6B7280;margin-top:2px;">Administrador</div>
            </div>
        </div>

        <!-- Datos -->
        <div style="display:flex;flex-direction:column;gap:16px;">
            <div>
                <label class="acme-label">Usuario</label>
                <div style="padding:8px 10px;background:#F7F6F3;border:1px solid #E5E4E0;
                            border-radius:3px;font-size:13px;color:#1A1A1A;">
                    @Model.Username
                </div>
            </div>
            <div>
                <label class="acme-label">Miembro desde</label>
                <div style="padding:8px 10px;background:#F7F6F3;border:1px solid #E5E4E0;
                            border-radius:3px;font-size:13px;color:#1A1A1A;">
                    @Model.FechaCreacion.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
                </div>
            </div>
            <div>
                <label class="acme-label">Rol</label>
                <div style="padding:8px 10px;background:#F7F6F3;border:1px solid #E5E4E0;
                            border-radius:3px;font-size:13px;color:#1A1A1A;">
                    Administrador
                </div>
            </div>
        </div>

        <div style="margin-top:24px;padding-top:20px;border-top:1px solid #E5E4E0;">
            <a href="@Url.Action("Logout","Account")" class="btn-danger-acme"
               style="text-decoration:none;display:inline-block;">
                Cerrar sesi&oacute;n
            </a>
        </div>
    </div>
</div>
