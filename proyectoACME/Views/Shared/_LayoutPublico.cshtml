<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - AcmeSurveys</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/encuestas.css")" rel="stylesheet">
</head>
<body style="background:#F7F6F3;">
    <div id="toast-container"></div>
    @RenderBody()

    <!-- Modal campo requerido -->
    <div id="modalCampoVacio" class="modal-overlay" style="display:none;">
        <div class="modal-acme" style="max-width:400px;">
            <div class="modal-header">
                <h3 style="margin:0;font-size:16px;font-weight:600;color:#1A1A1A;">Campo incompleto</h3>
            </div>
            <div class="modal-body">
                <p style="margin:0;font-size:14px;color:#6B7280;">
                    Debes completar al menos un campo antes de enviar la encuesta.
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn-acme" onclick="cerrarModalCampo()">Entendido</button>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Scripts/validaciones.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>